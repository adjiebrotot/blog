---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign all_docs = site.pages | concat: site.posts -%}
{%- for d in all_docs -%}
  {%- if d.lang and d.sitemap != false and d.noindex != true %}
  <url>
    <loc>{{ d.url | absolute_url }}</loc>
    {%- if d.last_modified_at or d.date %}
    <lastmod>{{ d.last_modified_at | default: d.date | date_to_xmlschema }}</lastmod>
    {%- endif -%}
    {%- include alternates.html doc=d docs=all_docs format="xhtml" %}
  </url>
  {%- endif -%}
{%- endfor %}
</urlset>
